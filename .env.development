# ============================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================
# Shared settings for team development
# SAFE to commit to Git (no secrets)
# Local secrets override in .env.local
# ============================================

# Node environment
NODE_ENV="development"

# Next.js configuration
NEXTAUTH_URL="http://localhost:3000"
PORT="3000"

# Azure Communication Services — Development
# In dev, we typically use dry-run mode to avoid sending actual emails
ACS_DRY_RUN="true"

# Logging and debugging
# Useful for debugging during development
# DEBUG="*"  # Uncomment to enable debug logging
