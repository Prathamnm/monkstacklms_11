# Database
# Local (docker-compose): postgresql://moonshine:moonshine@localhost:5433/moonshine_lms
# Azure PostgreSQL Flexible Server (SSL required):
# postgresql://<user%40server>:<password-url-encoded>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require
DATABASE_URL="postgresql://moonshine:moonshine@localhost:5433/moonshine_lms"

# Azure Entra ID / MSAL (Public - safe for client)
NEXT_PUBLIC_AZURE_AD_CLIENT_ID="4a53900c-d011-4f01-a9bc-8215c8071be6"
NEXT_PUBLIC_AZURE_AD_TENANT_ID="6324eb41-5027-4fd5-8655-3e23d3fd889e"
# Must match a redirect URI registered on your Entra app; path must be /auth/callback
NEXT_PUBLIC_AZURE_AD_REDIRECT_URI="http://localhost:3000/auth/callback"

# Azure Entra ID / MSAL — used for authentication and user sync ONLY (not email)
AZURE_AD_CLIENT_ID="4a53900c-d011-4f01-a9bc-8215c8071be6"
AZURE_AD_TENANT_ID="6324eb41-5027-4fd5-8655-3e23d3fd889e"
AZURE_AD_CLIENT_SECRET="your-entra-id-client-secret"

# Azure Communication Services — Email
# Get the connection string from the ACS resource → Keys blade in Azure Portal
ACS_CONNECTION_STRING="YOUR_ACS_CONNECTION_STRING"
# The sender address provisioned on the ACS Email Domain
# Format: no-reply@<subdomain>.azurecomm.net  OR  no-reply@yourdomain.com (if custom domain)
ACS_SENDER_ADDRESS="no-reply@moonshine.azurecomm.net"
# Set to "true" in local dev to log emails without actually sending them
ACS_DRY_RUN="false"
# Optional: override all email recipients with this address during testing
# DEBUG_EMAIL_OVERRIDE="your-personal@email.com"


# App
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<random-32-char-string>"
NODE_ENV="development"
PORT="3000"

# Optional: Azure Application Insights (skip for local dev)
APPLICATIONINSIGHTS_CONNECTION_STRING=""
