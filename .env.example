# ============================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env.local and fill with your actual values
# NEVER commit secrets to version control
# ============================================

# =============
# DATABASE
# =============
# Local (docker-compose): postgresql://moonshine:moonshine@localhost:5433/moonshine_lms
# Azure PostgreSQL: postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require
DATABASE_URL="postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require"

# =============
# AZURE ENTRA ID (MSAL)
# =============
# Public credentials (safe to expose via NEXT_PUBLIC_)
NEXT_PUBLIC_AZURE_AD_CLIENT_ID="4a53900c-d011-4f01-a9bc-8215c8071be6"
NEXT_PUBLIC_AZURE_AD_TENANT_ID="6324eb41-5027-4fd5-8655-3e23d3fd889e"
# Must match registered redirect URI in your Entra app
NEXT_PUBLIC_AZURE_AD_REDIRECT_URI="http://localhost:3000/auth/callback"

# Server-side credentials (NEVER prefix with NEXT_PUBLIC_)
AZURE_AD_CLIENT_ID="4a53900c-d011-4f01-a9bc-8215c8071be6"
AZURE_AD_TENANT_ID="6324eb41-5027-4fd5-8655-3e23d3fd889e"
AZURE_AD_CLIENT_SECRET="YOUR_CLIENT_SECRET_HERE"

# =============
# NEXTAUTH CONFIGURATION
# =============
# Use: openssl rand -base64 32
NEXTAUTH_SECRET="YOUR_RANDOM_32_CHAR_SECRET_HERE"
NEXTAUTH_URL="http://localhost:3000"

# =============
# AZURE COMMUNICATION SERVICES (EMAIL)
# =============
# Leave empty to skip email sending
ACS_CONNECTION_STRING="YOUR_ACS_CONNECTION_STRING"
ACS_SENDER_ADDRESS="no-reply@yourdomain.azurecomm.net"
# Set to "true" in local dev to log emails without sending
ACS_DRY_RUN="true"
# Optional: override all email recipients during testing
# DEBUG_EMAIL_OVERRIDE="your-email@example.com"

# =============
# APPLICATION CONFIGURATION
# =============
NODE_ENV="development"
PORT="3000"

# =============
# AZURE APPLICATION INSIGHTS (Optional)
# =============
# Leave empty to skip Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# =============
# OPTIONAL: FOR SYNC SCRIPTS
# =============
# Production database connection for sync operations (if needed)
# PROD_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
