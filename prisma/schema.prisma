generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                    String             @id @default(cuid())
  entraObjectId         String             @unique
  workEmail             String             @unique @map("email")
  notificationEmail     String?            @map("notification_email")
  displayName           String
  firstName             String
  lastName              String
  jobTitle              String?
  phoneNumber           String?
  profilePictureUrl     String?
  role                  Role               @default(EMPLOYEE)
  employmentStatus      EmploymentStatus   @default(ACTIVE)
  managerId             String?
  joinDate              DateTime           @default(now())
  terminationDate       DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  emergencyName         String?
  emergencyRelation     String?
  emergencyPhone        String?
  announcements         Announcement[]
  auditLogsPerformed    AuditLog[]         @relation("AuditPerformer")
  auditLogsTargeted     AuditLog[]         @relation("AuditTarget")
  manager               Employee?          @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates          Employee[]         @relation("ManagerSubordinates")
  leaveBalance          LeaveBalance?
  leaveLedgerEntries    LeaveLedgerEntry[]
  approvedLeaves        LeaveRequest[]     @relation("ApproverLeaveRequests")
  leaveRequests         LeaveRequest[]     @relation("EmployeeLeaveRequests")
  receivedNotifications Notification[]     @relation("NotificationRecipient")
  sentNotifications     Notification[]     @relation("NotificationSender")

  @@map("employees")
}

model LeaveRequest {
  id               String      @id @default(cuid())
  employeeId       String
  title            String      @default("")
  startDate        DateTime
  endDate          DateTime
  startHalfDay     HalfDayType @default(NONE)
  endHalfDay       HalfDayType @default(NONE)
  totalDays        Float
  reason           String
  isEmergency      Boolean     @default(false)
  status           LeaveStatus @default(PENDING)
  approverId       String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  approverComments String?
  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?
  cancelledAt      DateTime?
  emailsSent       Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  approver         Employee?   @relation("ApproverLeaveRequests", fields: [approverId], references: [id])
  employee         Employee    @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id])

  @@map("leave_requests")
}

model LeaveBalance {
  id                   String   @id @default(cuid())
  employeeId           String   @unique
  year                 Int
  standardTotal        Float    @default(18)
  standardAccrued      Float    @default(0)
  standardUsed         Float    @default(0)
  standardCarryForward Float    @default(0)
  emergencyTotal       Float    @default(2)
  emergencyUsed        Float    @default(0)
  updatedAt            DateTime @updatedAt
  floaterTotal         Float    @default(2)
  floaterUsed          Float    @default(0)
  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_balances")
}

model LeaveLedgerEntry {
  id          String          @id @default(cuid())
  employeeId  String
  type        LedgerEntryType
  days        Float
  reason      String
  referenceId String?
  performedBy String?
  year        Int
  month       Int?
  createdAt   DateTime        @default(now())
  employee    Employee        @relation(fields: [employeeId], references: [id])

  @@map("leave_ledger_entries")
}

model AccrualRule {
  id                     String   @id @default(cuid())
  name                   String   @default("Default Accrual Rule")
  standardLeavesPerYear  Float    @default(18)
  emergencyLeavesPerYear Float    @default(2)
  accrualMethod          String   @default("YEARLY_FLAT")
  daysPerMonth           Float    @default(1.5)
  carryForwardEnabled    Boolean  @default(true)
  carryForwardMaxDays    Float    @default(10)
  isActive               Boolean  @default(true)
  effectiveFrom          DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("accrual_rules")
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  recipientId String
  senderId    String?
  referenceId String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   Employee         @relation("NotificationRecipient", fields: [recipientId], references: [id])
  sender      Employee?        @relation("NotificationSender", fields: [senderId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  performedBy String
  targetId    String?
  details     Json
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  performer   Employee    @relation("AuditPerformer", fields: [performedBy], references: [id])
  target      Employee?   @relation("AuditTarget", fields: [targetId], references: [id])

  @@map("audit_logs")
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model PublicHoliday {
  id        String      @id @default(cuid())
  name      String
  date      DateTime
  type      HolidayType @default(PUBLIC)
  notes     String?
  createdBy String
  createdAt DateTime    @default(now())

  @@map("public_holidays")
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  postedBy  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  deletedBy String?
  poster    Employee  @relation(fields: [postedBy], references: [id])

  @@map("announcements")
}

enum Role {
  EMPLOYEE
  MANAGER
  HR
  ADMIN
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
}

enum HalfDayType {
  NONE
  HALF_DAY
}

enum LedgerEntryType {
  ACCRUAL
  USAGE
  REVERSAL
  ADJUSTMENT
  CARRY_FORWARD
  YEAR_RESET
  EMERGENCY_GRANT
}

enum NotificationType {
  LEAVE_APPLIED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
  LEAVE_REVOKED
  BALANCE_ADJUSTED
  SYSTEM
  HOLIDAY_CREATED
  ANNOUNCEMENT_POSTED
  ROLE_CHANGED
  ACCOUNT_DEACTIVATED
}

enum AuditAction {
  LEAVE_APPLY
  LEAVE_APPROVE
  LEAVE_REJECT
  LEAVE_CANCEL
  LEAVE_REVOKE
  BALANCE_ADJUST
  EMPLOYEE_UPDATE
  RULES_UPDATE
  ACCRUAL_RUN
  ROLE_CHANGE
  HOLIDAY_CREATE
  ANNOUNCEMENT_POST
  ANNOUNCEMENT_DELETE
  ADMIN_OVERRIDE
  ACCOUNT_DEACTIVATE
}

enum HolidayType {
  PUBLIC
  FLOATER
}
