generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Employee {
  id               String           @id @default(cuid())
  entraObjectId    String           @unique
  workEmail        String           @unique @map("email")
  firstName        String
  lastName         String
  displayName      String?
  role             Role             @default(EMPLOYEE)
  status           EmploymentStatus @default(ACTIVE)
  managerId        String?
  joinedAt         DateTime         @default(now())
  terminatedAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  profile          EmployeeProfile?
  manager          Employee?        @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates     Employee[]       @relation("ManagerSubordinates")
  leaveRequests    LeaveRequest[]   @relation("EmployeeLeaveRequests")
  approvedLeaves   LeaveRequest[]   @relation("ApproverLeaveRequests")
  leaveLedgerEntries LeaveLedgerEntry[]
  auditLogsPerformed AuditLog[]     @relation("AuditPerformer")
  auditLogsTargeted  AuditLog[]     @relation("AuditTarget")
  sentMessages     Message[]        @relation("MessageSender")
  receivedMessages Message[]        @relation("MessageRecipient")

  @@map("employees")
}

model EmployeeProfile {
  employeeId        String   @id
  phone             String?
  jobTitle          String?
  profilePictureUrl String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  timezone          String   @default("UTC")
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}


model LeaveType {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  yearlyQuota       Float
  isAccrued         Boolean  @default(false)
  carryForwardLimit Float?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  leaveRequests     LeaveRequest[]

  @@map("leave_types")
}

model LeaveRequest {
  id             String      @id @default(cuid())
  employeeId     String
  leaveTypeId    String
  approverId     String?
  startDate      DateTime
  endDate        DateTime
  totalDays      Float
  reason         String
  status         LeaveStatus @default(PENDING)
  statusChangedAt DateTime?
  statusReason   String?
  createdAt      DateTime    @default(now())
  employee       Employee    @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id])
  approver       Employee?   @relation("ApproverLeaveRequests", fields: [approverId], references: [id])
  leaveType      LeaveType   @relation(fields: [leaveTypeId], references: [id])
  leaveRequestDays LeaveRequestDay[]

  @@map("leave_requests")
}

model LeaveRequestDay {
  id             String      @id @default(cuid())
  leaveRequestId String
  date           DateTime    @db.Date
  portion        HalfDayType @default(NONE)
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, date])
  @@map("leave_request_days")
}

model LeaveLedgerEntry {
  id          String          @id @default(cuid())
  employeeId  String
  leaveTypeId String?
  entryType   LedgerEntryType
  days        Float
  referenceId String?
  reason      String
  performedBy String?
  createdAt   DateTime        @default(now())
  employee    Employee        @relation(fields: [employeeId], references: [id])

  @@map("leave_ledger_entries")
}



model Message {
  id          String      @id @default(cuid())
  type        MessageType
  title       String
  content     String
  senderId    String?
  recipientId String?
  isGlobal    Boolean     @default(false)
  isRead      Boolean     @default(false)
  readAt      DateTime?
  createdAt   DateTime    @default(now())
  sender      Employee?   @relation("MessageSender", fields: [senderId], references: [id])
  recipient   Employee?   @relation("MessageRecipient", fields: [recipientId], references: [id])

  @@map("messages")
}


model PublicHoliday {
  id        String      @id @default(cuid())
  name      String
  date      DateTime
  type      HolidayType @default(PUBLIC)
  notes     String?
  createdAt DateTime    @default(now())

  @@map("public_holidays")
}

model Policy {
  id         String   @id @default(cuid())
  title      String
  fileName   String
  fileUrl    String
  uploadedBy String
  createdAt  DateTime @default(now())

  @@map("policies")
}


model AuditLog {
  id         String   @id @default(cuid())
  action     String
  performedBy String
  targetId   String?
  details    Json
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  performer  Employee  @relation("AuditPerformer", fields: [performedBy], references: [id])
  target     Employee? @relation("AuditTarget", fields: [targetId], references: [id])

  @@map("audit_logs")
}

model SystemSettings {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// ENUMS

enum Role {
  EMPLOYEE
  MANAGER
  HR
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
}

enum HalfDayType {
  NONE
  HALF_DAY
}

enum LedgerEntryType {
  ACCRUAL
  USAGE
  ADJUSTMENT
  REVERSAL
  CARRY_FORWARD
}

enum MessageType {
  SYSTEM
  LEAVE
  ANNOUNCEMENT
}

enum HolidayType {
  PUBLIC
  FLOATER
}
