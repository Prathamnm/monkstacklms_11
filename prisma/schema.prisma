generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                String            @id
  entraObjectId     String            @unique
  email             String            @unique
  firstName         String
  lastName          String
  displayName       String?
  role              Role
  status            EmploymentStatus
  managerId         String?
  joinedAt          DateTime
  terminatedAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  manager           Employee?         @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subordinates      Employee[]        @relation("ManagerSubordinates")
  profile           EmployeeProfile?
  leaveRequests     LeaveRequest[]    @relation("EmployeeLeaveRequests")
  approvedLeaves    LeaveRequest[]    @relation("ApproverLeaveRequests")
  leaveLedgerEntries LeaveLedgerEntry[]
  attendanceRecords AttendanceRecord[]
  sentMessages      Message[]         @relation("MessageSender")
  receivedMessages  Message[]         @relation("MessageRecipient")

  @@index([managerId])
  @@index([email])
  @@map("employees")
}

model EmployeeProfile {
  employeeId        String   @id
  phone             String?
  jobTitle          String?
  profilePictureUrl String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  timezone          String   @default("UTC")
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("employee_profiles")
}

model LeaveType {
  id                String             @id
  code              String             @unique
  name              String
  yearlyQuota       Float
  isAccrued         Boolean
  carryForwardLimit Float?
  isActive          Boolean
  createdAt         DateTime           @default(now())
  leaveRequests     LeaveRequest[]
  leaveLedgerEntries LeaveLedgerEntry[]

  @@index([code])
  @@map("leave_types")
}

model LeaveRequest {
  id              String            @id
  employeeId      String
  leaveTypeId     String
  approverId      String?
  startDate       DateTime
  endDate         DateTime
  totalDays       Float
  reason          String
  status          LeaveStatus
  statusChangedAt DateTime?
  statusReason    String?
  isEmergency     Boolean
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  employee        Employee          @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approver        Employee?         @relation("ApproverLeaveRequests", fields: [approverId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  leaveType       LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  leaveRequestDays LeaveRequestDay[]
  ledgerEntries   LeaveLedgerEntry[] @relation("LeaveRequestLedgerEntries")

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([approverId])
  @@index([status])
  @@map("leave_requests")
}

model LeaveRequestDay {
  id             String      @id
  leaveRequestId String
  date           DateTime    @db.Date
  portion        HalfDayType
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([leaveRequestId, date])
  @@index([leaveRequestId])
  @@index([date])
  @@map("leave_request_days")
}

model LeaveLedgerEntry {
  id          String          @id
  employeeId  String
  leaveTypeId String
  entryType   LedgerEntryType
  days        Float
  referenceId String?
  reason      String
  performedBy String?
  createdAt   DateTime        @default(now())
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  leaveType   LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reference   LeaveRequest?   @relation("LeaveRequestLedgerEntries", fields: [referenceId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([entryType])
  @@index([referenceId])
  @@map("leave_ledger_entries")
}

model AttendanceRecord {
  id          String   @id
  employeeId  String
  date        DateTime @db.Date
  punchIn     DateTime?
  punchOut    DateTime?
  hoursWorked Float?
  source      String?
  createdAt   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendance_records")
}

model Message {
  id          String      @id
  type        MessageType
  title       String
  content     String
  senderId    String?
  recipientId String?
  isGlobal    Boolean
  isRead      Boolean
  readAt      DateTime?
  createdAt   DateTime    @default(now())
  sender      Employee?   @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recipient   Employee?   @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([type])
  @@index([isGlobal])
  @@index([isRead])
  @@map("messages")
}

model PublicHoliday {
  id        String      @id
  name      String
  date      DateTime    @db.Date
  type      HolidayType
  notes     String?
  createdAt DateTime    @default(now())

  @@unique([date])
  @@index([date])
  @@index([type])
  @@map("public_holidays")
}

model Policy {
  id         String   @id
  title      String
  fileName   String
  fileUrl    String
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([uploadedBy])
  @@index([createdAt])
  @@map("policies")
}

model AuditLog {
  id          String   @id
  action      String
  performedBy String
  targetId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([performedBy])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSettings {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime

  @@map("system_settings")
}

enum Role {
  EMPLOYEE
  MANAGER
  HR
  ADMIN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDayType {
  NONE
  HALF_DAY
}

enum LedgerEntryType {
  ACCRUAL
  USAGE
  ADJUSTMENT
  REVERSAL
  CARRY_FORWARD
}

enum MessageType {
  SYSTEM
  LEAVE
  ANNOUNCEMENT
}

enum HolidayType {
  PUBLIC
  FLOATER
}
